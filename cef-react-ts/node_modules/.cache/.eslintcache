\n\n\n",[],"X:\\ReverseRP\\cef-react-ts\\src\\App.tsx",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\conf.ts",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\AppRouter.tsx",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\context\\NavigationContextProvider.tsx",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\components\\hud\\Hud.tsx",["94"],[],"import React, {useEffect} from 'react';\r\nimport {Space} from \"antd\";\r\nimport {useNavigationContext} from \"../../context/NavigationContextProvider\";\r\nimport {Config} from \"../../conf\";\r\nimport Keys from \"./Keys\";\r\n\r\n\r\n\r\n\r\n\r\n\r\nconst Hud : React.FC = () => {\r\n    const navigationContext = useNavigationContext();\r\n\r\n    useEffect(()=>{\r\n\r\n    },[])\r\n\r\n    return (\r\n        <Space style={{width: Config.screenResolution.width, height: Config.screenResolution.height, position: 'absolute'}}>\r\n            {navigationContext.navigation?.hud &&\r\n                <Space>\r\n                    <Space align={\"center\"} style={{marginLeft:20}}>\r\n                        <Keys/>\r\n                    </Space>\r\n                </Space>\r\n            }\r\n        </Space>\r\n    );\r\n};\r\n\r\nexport default Hud;","X:\\ReverseRP\\cef-react-ts\\src\\components\\auth\\Auth.tsx",["95","96"],[],"import React, {useState} from 'react';\r\nimport {Card, Menu, MenuProps, Space} from \"antd\";\r\nimport {Config} from \"../../conf\";\r\n\r\n// @ts-ignore\r\nimport background from'../../assets/images/background_auth.png';\r\nimport Login from \"./Login\";\r\nimport Registration from \"./Registration\";\r\n\r\nconst Auth : React.FC = () => {\r\n    const items: MenuProps['items'] = [\r\n        {\r\n            label: 'Вход',\r\n            key: 'login',\r\n        },\r\n        {\r\n            label: 'Регистрация',\r\n            key: 'registration',\r\n        },\r\n    ]\r\n    const [current, setCurrent] = useState('login');\r\n    const onClick: MenuProps['onClick'] = (e) => {\r\n        setCurrent(e.key);\r\n    };\r\n\r\n    return (\r\n        <Space style={{position:'absolute',width:Config.screenResolution.width, height:Config.screenResolution.height, backgroundImage:`url('${background}')`, justifyContent: 'center'}}>\r\n            <Card style={{width: 800, height: 600}}>\r\n                <Space direction={\"vertical\"} style={{width: '100%', height: '100%', alignItems: 'center'}}>\r\n                    <Menu style={{width: 200, justifyContent: 'center'}} onClick={onClick} selectedKeys={[current]} mode=\"horizontal\" items={items} />\r\n                    <Space align={\"center\"} style={{width: '100%', height: 450, justifyContent: 'center'}}>\r\n                        {current === 'login' && <Login/>}\r\n                        {current === 'registration' && <Registration/>}\r\n                    </Space>\r\n                </Space>\r\n            </Card>\r\n        </Space>\r\n    );\r\n};\r\n\r\nexport default Auth;","X:\\ReverseRP\\cef-react-ts\\src\\components\\hud\\Keys.tsx",["97"],[],"import React, {useState} from 'react';\r\nimport {Space, Typography} from \"antd\";\r\nimport {MenuOutlined, PhoneOutlined, PlusOutlined, UserOutlined} from \"@ant-design/icons\";\r\nconst { Title } = Typography;\r\n\r\nconst Keys : React.FC = () => {\r\n    const [keys,setKeys] = useState([\r\n        {text:\"Телефон\", key:\"P\", icon: <PhoneOutlined style={{fontSize: '34px', color: '#9a9a9d'}}/>},\r\n        {text:\"Меню\", key:\"M\", icon: <MenuOutlined style={{fontSize: '34px', color: '#9a9a9d'}}/>},\r\n        {text:\"Курсор\", key:\"F2\", icon: <PlusOutlined style={{fontSize: '34px', color: '#9a9a9d'}}/>},\r\n        {text:\"Инвентарь\", key:\"I\", icon: <UserOutlined style={{fontSize: '34px', color: '#9a9a9d'}}/>},\r\n    ])\r\n    try {\r\n        mp.events.add(\"CLIENT::CEF::HUD_IS_VISIBLE_KEYS_FOR_CARS\", (visible: boolean) => {\r\n\r\n        })\r\n    }catch (e){\r\n\r\n    }\r\n\r\n    return (\r\n        <Space direction={\"vertical\"}>\r\n            {keys.map(key=>\r\n                <Space direction={\"horizontal\"} align={\"center\"}>\r\n                    <Space align={\"center\"} key={key.text} style={{width:40,height:42, textAlign: 'center', padding: 0, backgroundColor: 'white', borderRadius:'10px', justifyContent: 'center'}}>\r\n                        <Title level={4} style={{textAlign:\"center\", margin: 0, color:'#4b4a4a'}}>{key.key}</Title>\r\n                    </Space>\r\n                    {key.icon}\r\n                </Space>\r\n            )}\r\n        </Space>\r\n    );\r\n};\r\n\r\nexport default Keys;","X:\\ReverseRP\\cef-react-ts\\src\\components\\auth\\Login.tsx",["98","99"],[],"import React from 'react';\r\nimport {Button, Checkbox, Form, Input, notification, Typography} from \"antd\";\r\nimport {LockOutlined, UserOutlined} from \"@ant-design/icons\";\r\nimport {Client} from \"../../requests/Client\";\r\nimport {useNavigationContext} from \"../../context/NavigationContextProvider\";\r\nimport hud from \"../hud/Hud\";\r\n\r\nconst { Link } = Typography;\r\n\r\n\r\nconst Login : React.FC = () => {\r\n    const onFinish = (values: any) => {\r\n        Client.triggerServer(\"CEF::SERVER::ON_FINISH_LOGIN\",values.login,values.password, values.remember)\r\n    };\r\n    try {\r\n        mp.events.add(\"SERVER::CEF::ERROR_LOGIN\", (text) => {\r\n            console.log(text+\" LOOOOOOOOOOOG\");\r\n            notification.error({\r\n                message: \"Уведомление\",\r\n                description: text,\r\n                placement: \"top\"\r\n            })\r\n        })\r\n    }catch (e) {\r\n        \r\n    }\r\n\r\n    return (\r\n        <Form\r\n            name=\"normal_login\"\r\n            initialValues={{ remember: true }}\r\n            onFinish={onFinish}\r\n            style={{width: '300px'}}\r\n        >\r\n            <Form.Item\r\n                name=\"login\"\r\n                rules={[{ required: true, message: 'Пожалуйста введите логин!' }]}\r\n            >\r\n                <Input prefix={<UserOutlined className=\"site-form-item-icon\" />} placeholder=\"Логин\" />\r\n            </Form.Item>\r\n            <Form.Item\r\n                name=\"password\"\r\n                rules={[{ required: true, message: 'Пожалуйста введите пароль!' }]}\r\n            >\r\n                <Input\r\n                    prefix={<LockOutlined className=\"site-form-item-icon\" />}\r\n                    type=\"password\"\r\n                    placeholder=\"Пароль\"\r\n                />\r\n            </Form.Item>\r\n            <Form.Item>\r\n                <Form.Item name=\"remember\" valuePropName=\"checked\" noStyle>\r\n                    <Checkbox>Запомнить меня</Checkbox>\r\n                </Form.Item>\r\n                <Link href=\"\" style={{float: \"right\"}}>\r\n                    Забыли пароль\r\n                </Link>\r\n            </Form.Item>\r\n\r\n            <Form.Item>\r\n                <Button type=\"primary\" htmlType=\"submit\" style={{width: '100%'}}>\r\n                    Войти\r\n                </Button>\r\n            </Form.Item>\r\n        </Form>\r\n    );\r\n};\r\n\r\nexport default Login;\r\n\r\n","X:\\ReverseRP\\cef-react-ts\\src\\components\\auth\\Registration.tsx",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\requests\\Client.ts",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\components\\character\\createCharacter\\CreateCharacter.tsx",["100","101"],[],"X:\\ReverseRP\\cef-react-ts\\src\\components\\character\\createCharacter\\Steps\\Hair.tsx",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\components\\character\\createCharacter\\Steps\\Face.tsx",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\components\\character\\createCharacter\\Steps\\SkinFeatures.tsx",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\components\\character\\createCharacter\\Steps\\Genetics.tsx",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\components\\character\\createCharacter\\Steps\\Clothes.tsx",[],[],{"ruleId":"102","severity":1,"message":"103","line":7,"column":7,"nodeType":