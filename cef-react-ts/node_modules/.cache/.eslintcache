nimport Registration from \"./Registration\";\r\n\r\nconst Auth : React.FC = () => {\r\n    const items: MenuProps['items'] = [\r\n        {\r\n            label: 'Вход',\r\n            key: 'login',\r\n        },\r\n        {\r\n            label: 'Регистрация',\r\n            key: 'registration',\r\n        },\r\n    ]\r\n    const [current, setCurrent] = useState('login');\r\n    const onClick: MenuProps['onClick'] = (e) => {\r\n        setCurrent(e.key);\r\n    };\r\n\r\n    return (\r\n        <Space style={{position:'absolute',width:Config.screenResolution.width, height:Config.screenResolution.height, backgroundImage:`url('${background}')`, justifyContent: 'center'}}>\r\n            <Card style={{width: 800, height: 600}}>\r\n                <Space direction={\"vertical\"} style={{width: '100%', height: '100%', alignItems: 'center'}}>\r\n                    <Menu style={{width: 200, justifyContent: 'center'}} onClick={onClick} selectedKeys={[current]} mode=\"horizontal\" items={items} />\r\n                    <Space align={\"center\"} style={{width: '100%', height: 450, justifyContent: 'center'}}>\r\n                        {current === 'login' && <Login/>}\r\n                        {current === 'registration' && <Registration/>}\r\n                    </Space>\r\n                </Space>\r\n            </Card>\r\n        </Space>\r\n    );\r\n};\r\n\r\nexport default Auth;","X:\\ReverseRP\\cef-react-ts\\src\\components\\hud\\Keys.tsx",["102"],[],"import React, {useState} from 'react';\r\nimport {Space, Typography} from \"antd\";\r\nimport {MenuOutlined, PhoneOutlined, PlusOutlined, UserOutlined} from \"@ant-design/icons\";\r\nconst { Title } = Typography;\r\n\r\nconst Keys : React.FC = () => {\r\n    const [keys,setKeys] = useState([\r\n        {text:\"Телефон\", key:\"P\", icon: <PhoneOutlined style={{fontSize: '34px', color: '#9a9a9d'}}/>},\r\n        {text:\"Меню\", key:\"M\", icon: <MenuOutlined style={{fontSize: '34px', color: '#9a9a9d'}}/>},\r\n        {text:\"Курсор\", key:\"F2\", icon: <PlusOutlined style={{fontSize: '34px', color: '#9a9a9d'}}/>},\r\n        {text:\"Инвентарь\", key:\"I\", icon: <UserOutlined style={{fontSize: '34px', color: '#9a9a9d'}}/>},\r\n    ])\r\n    try {\r\n        mp.events.add(\"CLIENT::CEF::HUD_IS_VISIBLE_KEYS_FOR_CARS\", (visible: boolean) => {\r\n\r\n        })\r\n    }catch (e){\r\n\r\n    }\r\n\r\n    return (\r\n        <Space direction={\"vertical\"}>\r\n            {keys.map(key=>\r\n                <Space direction={\"horizontal\"} align={\"center\"}>\r\n                    <Space align={\"center\"} key={key.text} style={{width:40,height:42, textAlign: 'center', padding: 0, backgroundColor: 'white', borderRadius:'10px', justifyContent: 'center'}}>\r\n                        <Title level={4} style={{textAlign:\"center\", margin: 0, color:'#4b4a4a'}}>{key.key}</Title>\r\n                    </Space>\r\n                    {key.icon}\r\n                </Space>\r\n            )}\r\n        </Space>\r\n    );\r\n};\r\n\r\nexport default Keys;","X:\\ReverseRP\\cef-react-ts\\src\\components\\auth\\Login.tsx",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\components\\auth\\Registration.tsx",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\requests\\Client.ts",[],[],"X:\\ReverseRP\\cef-react-ts\\src\\components\\character\\createCharacter\\CreateCharacter.tsx",["103","104"],[],"import React, {useState} from 'react';\r\nimport {Button, Card, message, Space, Steps, theme} from \"antd\";\r\nimport {Config} from \"../../../conf\";\r\nimport {\r\n    CheckOutlined,\r\n    DeploymentUnitOutlined,\r\n    HighlightOutlined,\r\n    ScissorOutlined,\r\n    SkinOutlined,\r\n    SmileOutlined\r\n} from \"@ant-design/icons\";\r\nimport Genetics from \"./Steps/Genetics\";\r\nimport Face from \"./Steps/Face\";\r\nimport Hair from \"./Steps/Hair\";\r\nimport SkinFeatures from \"./Steps/SkinFeatures\";\r\nimport Clothes from \"./Steps/Clothes\";\r\nimport Finish from \"./Steps/Finish\";\r\n\r\n\r\n\r\nconst CreateCharacter: React.FC = () => {\r\n    const steps = [\r\n        {\r\n            title: 'Генетика',\r\n            content: <Genetics/>,\r\n            icon: <DeploymentUnitOutlined />,\r\n        },\r\n        {\r\n            title: 'Форма лица',\r\n            content: <Face/>,\r\n            icon: <SmileOutlined />\r\n        },\r\n        {\r\n            title: 'Волосы',\r\n            content: <Hair/>,\r\n            icon: <ScissorOutlined />\r\n        },\r\n        {\r\n            title: 'Особенности кожи',\r\n            content: <SkinFeatures/>,\r\n            icon: <HighlightOutlined />\r\n        },\r\n        {\r\n            title: 'Одежда',\r\n            content: <Clothes/>,\r\n            icon: <SkinOutlined />\r\n        },\r\n        {\r\n            title: '',\r\n            content: <Finish/>,\r\n            icon: <CheckOutlined />\r\n        },\r\n    ];\r\n    const [current,setCurrent] = useState<number>(0)\r\n\r\n    const handleClickFinish = () => {\r\n\r\n    }\r\n\r\n\r\n    return (\r\n        <Space direction={\"vertical\"} style={{position:'absolute',width:Config.screenResolution.width, height:Config.screenResolution.height}}>\r\n            <Card>\r\n                <Space style={{justifyContent: 'space-between', alignItems: 'center', width: '100%'}}>\r\n                    <Steps style={{width: Config.screenResolution.width - 400}} items={steps} current={current}/>\r\n                    <Space>\r\n                        {current === steps.length - 1 && <Button type=\"primary\" size={\"large\"} onClick={handleClickFinish}>Создать</Button>}\r\n                        {current < steps.length - 1 && <Button type=\"primary\" onClick={()=>setCurrent(prev=>prev+1)} size={\"large\"}>Дальше</Button>}\r\n                        {current > 0 && <Button onClick={()=>setCurrent(prev=>prev-1)} size={\"large\"}>Назад</Button>}\r\n                    </Space>\r\n                </Space>\r\n            </Card>\r\n            {steps[current].con